<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReSilico.UI.ViewModels"
        x:Class="ReSilico.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600">

    <Grid ColumnDefinitions="200,*">

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="#1E1E2E"
                Padding="0,16">
            <StackPanel Spacing="4" Margin="8,0">

                <TextBlock Text="ReSilico"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#CDD6F4"
                           Margin="8,0,0,24"/>

                <Button Content="Dashboard"
                        Command="{Binding GoToDashboardCommand}"
                        Classes="nav"/>
                <Button Content="Distributions"
                        Command="{Binding GoToDistributionEditorCommand}"
                        Classes="nav"/>
                <Button Content="Correlation Matrix"
                        Command="{Binding GoToCorrelationMatrixCommand}"
                        Classes="nav"/>
                <Button Content="Run Simulation"
                        Command="{Binding GoToSimulationCommand}"
                        Classes="nav"/>
                <Button Content="Results"
                        Command="{Binding GoToResultsCommand}"
                        Classes="nav"/>
            </StackPanel>
        </Border>

        <!-- Content Area (ViewLocator renders the active page) -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Margin="0"/>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#313244"/>
        </Style>
    </Window.Styles>
</Window>
