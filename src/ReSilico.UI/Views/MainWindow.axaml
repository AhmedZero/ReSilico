<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ReSilico.UI.ViewModels"
        x:Class="ReSilico.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        FontFamily="Inter, Segoe UI">

    <Grid ColumnDefinitions="240,*" Background="#11161B">

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="#151B21"
                Padding="0,16">
            <Grid RowDefinitions="Auto,*" Margin="14,0">

                <TextBlock Text="ReSilico"
                           Grid.Row="0"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#E5EDF3"
                           Margin="2,0,0,26"/>

                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding NavigateCommand}"
                                    Classes.navItem="{Binding !IsSelected}"
                                    Classes.navItemSelected="{Binding IsSelected}">
                                <TextBlock Text="{Binding Label}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Content Area (ViewLocator renders the active page) -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Margin="0"/>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.navItem, Button.navItemSelected">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.navItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DCE6EB"/>
        </Style>
        <Style Selector="Button.navItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#202A31"/>
        </Style>
        <Style Selector="Button.navItem:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.navItemSelected">
            <Setter Property="Background" Value="#263D44"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.navItemSelected /template/ ContentPresenter">
            <Setter Property="Background" Value="#263D44"/>
        </Style>
    </Window.Styles>
</Window>
