<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReSilico.UI.ViewModels"
             x:Class="ReSilico.UI.Views.SimulationView"
             x:DataType="vm:SimulationViewModel">
    <ScrollViewer>
        <StackPanel Margin="28" Spacing="18" MaxWidth="900">
            <TextBlock Text="Run Simulation" Classes="page-title"/>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#E5EDF3" FontSize="14"/>
                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="10"
                                 Foreground="#6BD5C9" Background="#2B343D" CornerRadius="5"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Run Simulation" Command="{Binding RunSimulationCommand}" Classes="primary"/>
                        <Button Content="Cancel" Command="{Binding CancelSimulationCommand}" Classes="secondary"
                                IsVisible="{Binding IsBusy}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Text="Live Log" Classes="section-title" Margin="0,0,0,10"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" MinHeight="260" Background="#11161B">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" Foreground="#AEBAC4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
