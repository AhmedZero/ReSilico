<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReSilico.UI.ViewModels"
             x:Class="ReSilico.UI.Views.SimulationView"
             x:DataType="vm:SimulationViewModel">

    <StackPanel Margin="32" Spacing="24" MaxWidth="640">

        <TextBlock Text="Run Simulation"
                   FontSize="28" FontWeight="Bold"
                   Foreground="#CDD6F4"/>

        <!-- Configuration panel -->
        <Border Background="#1E1E2E" CornerRadius="10" Padding="24">
            <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto">

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Realizations" Classes="lbl"/>
                <NumericUpDown Grid.Row="0" Grid.Column="1"
                               Value="{Binding NumberOfRealizations}"
                               Minimum="100" Maximum="500000"
                               Increment="1000"
                               FormatString="N0"
                               Classes="inp"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Random Seed" Classes="lbl"/>
                <NumericUpDown Grid.Row="1" Grid.Column="1"
                               Value="{Binding RandomSeed}"
                               Minimum="0" Maximum="999999"
                               Increment="1"
                               Classes="inp"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sampling Method" Classes="lbl"/>
                <ComboBox   Grid.Row="2" Grid.Column="1"
                            ItemsSource="{Binding SamplingMethods}"
                            SelectedItem="{Binding SelectedSamplingMethod}"
                            Classes="inp"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Latin Hypercube provides better variance reduction than Monte Carlo for the same realization count."
                           Foreground="#6C7086" FontSize="11"
                           TextWrapping="Wrap"
                           IsVisible="{Binding IsLhs}"
                           Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- Progress -->
        <Border Background="#1E1E2E" CornerRadius="10" Padding="24">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#CDD6F4" FontSize="13"/>
                <ProgressBar Value="{Binding Progress}"
                             Minimum="0" Maximum="100"
                             Height="8"
                             CornerRadius="4"
                             Foreground="#89B4FA"
                             Background="#313244"/>
            </StackPanel>
        </Border>

        <!-- Action buttons -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Run Simulation"
                    Command="{Binding RunSimulationCommand}"
                    Classes="primary"
                    IsEnabled="{Binding CanRun}"/>
            <Button Content="Cancel"
                    Command="{Binding CancelSimulationCommand}"
                    Classes="secondary"
                    IsVisible="{Binding IsBusy}"/>
        </StackPanel>

    </StackPanel>

    <UserControl.Styles>
        <Style Selector="TextBlock.lbl">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="NumericUpDown.inp, ComboBox.inp">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#F38BA8"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20,10"/>
        </Style>
    </UserControl.Styles>
</UserControl>
