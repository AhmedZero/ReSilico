<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReSilico.UI.ViewModels"
             x:Class="ReSilico.UI.Views.CorrelationMatrixView"
             x:DataType="vm:CorrelationMatrixViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="32,24">

        <!-- Title row -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <TextBlock DockPanel.Dock="Left"
                       Text="Correlation Matrix"
                       Classes="page-title"
                       VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right"
                    Content="Fix Matrix"
                    Command="{Binding FixMatrixCommand}"
                    Classes="primary"/>
        </DockPanel>

        <Border Grid.Row="1" Classes="card" Margin="0,0,0,16">
            <Grid ColumnDefinitions="160,240,180,160" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="Copula" Classes="label"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Copulas}" SelectedItem="{Binding SelectedCopula}"/>
                <TextBlock Grid.Column="2" Text="Degrees of freedom" Classes="label" IsVisible="{Binding IsTCopula}"/>
                <NumericUpDown Grid.Column="3" Value="{Binding DegreesOfFreedom}" Minimum="2.1" Maximum="100" Increment="1" IsVisible="{Binding IsTCopula}"/>
            </Grid>
        </Border>

        <!-- Validation -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ValidationMessage}"
                   Classes="error"
                   IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Margin="0,0,0,8"/>

        <!-- Hint -->
        <TextBlock Grid.Row="3"
                   Text="Off-diagonal values are kept symmetric automatically. Diagonal is locked at 1."
                   Foreground="#A6ADC8" FontSize="12"
                   Margin="0,0,0,16"/>

        <!-- Dynamic matrix built in code-behind -->
        <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Auto">
            <Border Classes="card">
                <Grid x:Name="PART_MatrixGrid"/>
            </Border>
        </ScrollViewer>

    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#89B4FA"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>
    </UserControl.Styles>
</UserControl>
